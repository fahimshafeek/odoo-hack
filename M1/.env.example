# Server Configuration
ENV=dev
PORT=8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_ENABLED=true

# Database (SQLite)
DATABASE_URL=sqlite:///./brightloop.db
TEST_DATABASE_URL=sqlite:///:memory:

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRE_HOURS=8
PASSWORD_RESET_EXPIRE_MINUTES=5

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Hari <hakku@mail.laddu.cc>

# Bootstrap Admin Credentials (Auto-created on seed)
BOOTSTRAP_ADMIN_EMAIL=admin@brightloop.test
BOOTSTRAP_ADMIN_PASSWORD=BrightloopAdmin@123
