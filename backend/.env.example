# Environment Configuration
ENV=dev
PORT=8000
FRONTEND_BASE_URL=http://localhost:5173

# Database (SQLite default)
DATABASE_URL=sqlite:///./brightloop.db

# JWT Security
JWT_SECRET=brightloop-dev-secret-key-change-in-prod
JWT_EXPIRE_HOURS=8
PASSWORD_RESET_EXPIRE_MINUTES=5

# Resend Email (Optional in dev/test)
RESEND_API_KEY=
EMAIL_FROM=Hari <hakku@mail.laddu.cc>

# Bootstrap Admin Credentials
BOOTSTRAP_ADMIN_EMAIL=admin@brightloop.test
BOOTSTRAP_ADMIN_PASSWORD=BrightloopAdmin@123

# Razorpay Payment Gateway (Optional / Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=
