{
	"name": "@brightloop/frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --configLoader native",
		"build": "vite build --configLoader native",
		"preview": "vite preview --configLoader native",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"typecheck": "npm run check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"e2e": "playwright test",
		"shots": "playwright test e2e/foundation.spec.js --project=chromium",
		"gen:api": "node --env-file-if-exists=.env scripts/generate-api.mjs",
		"check:static": "node scripts/check-no-static-data.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.0.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"msw": "^2.0.0",
		"openapi-typescript": "^7.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.0",
		"@lucide/svelte": "latest",
		"@tanstack/svelte-query": "^5.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"gsap": "^3.13.0",
		"openapi-fetch": "latest",
		"svelte-sonner": "^1.0.0",
		"tailwind-merge": "^3.0.0",
		"tailwind-variants": "^3.0.0",
		"zod": "^4.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#src/*": "./src/*"
	}
}
