# Environment mode: development | staging | production
APP_ENV=development

# Database Connection (SQLite default for fast local test/deploy, PostgreSQL in production)
DATABASE_URL=sqlite:///./brightloop.db

# Authentication & Security
SECRET_KEY=change-to-a-secure-random-32-character-secret-in-production
BOOTSTRAP_ADMIN_EMAIL=admin@brightloop.local
BOOTSTRAP_ADMIN_PASSWORD=change-admin-password-in-production

# Server Settings
PORT=8000
HOST=127.0.0.1
